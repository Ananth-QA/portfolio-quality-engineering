# Target Application Base URL (Required)
BASE_URL=https://ananth-portfolio-xi.vercel.app

# Environment Identifier (Optional: production, qa, staging)
TEST_ENV=production

# API Endpoint Configuration
MEDIUM_API_ENDPOINT=/api/medium

# Playwright Test Execution Options
HEADLESS=true
TRACE_MODE=retain-on-failure
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
